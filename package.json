{
  "name": "@starterpg/js",
  "version": "0.1.0",
  "description": "Client for a starterpg.com project: REST, RPC, auth, storage and realtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "postgres",
    "rest",
    "realtime"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarterPG-dev/starterpg-js.git"
  },
  "bugs": {
    "url": "https://github.com/StarterPG-dev/starterpg-js/issues"
  },
  "homepage": "https://www.starterpg.com/docs/api"
}
